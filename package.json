{
  "name": "discord-quest-selfbot",
  "version": "1.0.0",
  "description": "Quest Bot Auto Claim",
  "main": "bot.ts",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env bot.ts",
    "dev": "tsx --env-file-if-exists=.env --watch bot.ts",
    "build": "tsc",
    "start:prod": "node --env-file-if-exists=.env dist/bot.js",
    "check-token": "tsx --env-file-if-exists=.env scripts/check-token.ts",
    "list-quests": "tsx --env-file-if-exists=.env scripts/list-quests.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "User",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@discordjs/core": "^1.1.1",
    "@discordjs/rest": "^2.2.0",
    "@discordjs/ws": "^1.0.2",
    "discord-api-types": "^0.37.61",
    "undici": "^6.0.0",
    "chalk": "^4.1.2",
    "figlet": "^1.7.0",
    "cli-table3": "^0.6.3"
  }
}
