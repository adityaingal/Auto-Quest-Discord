{
  "name": "discord-quest-completer-bot",
  "version": "2.1.0",
  "description": "Discord Quest Completer - slash command bot with live quest tracking, per-user account rooms and optional quest automation",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot/index.js",
    "dev": "tsx watch bot/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check-env": "tsx scripts/check-env.ts"
  },
  "keywords": [
    "discord",
    "quests",
    "bot"
  ],
  "author": "adityaingal",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "discord-api-types": "^0.37.120",
    "discord.js": "^14.28.1",
    "figlet": "^1.7.0"
  }
}
