# Discord Quest Completer 2.1 - environment configuration
# Copy to .env and fill in the values. Never commit .env.

# --- required -------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=
# Application id of the same app (Developer Portal -> General Information)
DISCORD_CLIENT_ID=
# Key that encrypts every stored token. The bot refuses to start without it.
# Generate one with: openssl rand -hex 32
# The same key has to be used on every instance of the bot.
ENCRYPTION_KEY=

# --- OAuth2 (needed for /account link) -------------------------------------
# Client secret of the same app
DISCORD_CLIENT_SECRET=
# Redirect URI - must match the one registered in the Developer Portal.
# For Render: https://<your-service>.onrender.com/oauth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- optional --------------------------------------------------------------
# Discord user id of the bot owner (full admin access). Several ids may be
# given, comma separated - every id gets the same full access.
OWNER_ID=id-one,id-two
# Role id that may use the /admin commands
ADMIN_ROLE_ID=
# Guild id for instant slash command registration (global registration is
# slower but works everywhere)
GUILD_ID=
# SQLite database location. Use a persistent disk on Render.
DATABASE_PATH=data/quest-bot.sqlite
# Path to the quest catalogue snapshot
QUEST_CATALOG_PATH=quest.json
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Minutes between notification checks
NOTIFICATION_INTERVAL_MINUTES=15
# HTTP port for the health endpoint and the OAuth2 callback
PORT=3000
# A Discord webhook URL in the developer guild. When set, the bot posts every
# room event there (room created, account added, account removed). The
# webhook belongs to you, not to your users, and the token is never sent -
# only the room name, the account and the event type.
# WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- optional: notifications ----------------------------------------------
# Channel that receives the status messages (quest completed, ...).
# The bot token is reused automatically when BOT_TOKEN is not set.
# NOTIFY_CHANNEL_ID=CHANNEL_ID
# BOT_TOKEN=

# --- optional: operator user session -------------------------------------
# A Discord *user* token for the operator. With it the bot can read the live
# quests of that account and complete them. It is against the Discord terms
# of service.
# Regular users add their own accounts with "/room add".
# USER_TOKEN=
