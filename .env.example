# Discord Quest Completer 2.1 - environment configuration
# Copy to .env and fill in the values. Never commit .env.

# --- required -------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=
# Application id of the same app (Developer Portal -> General Information)
DISCORD_CLIENT_ID=
# Key that encrypts every stored token. The bot refuses to start without it.
# Generate one with: openssl rand -hex 32
# The same key has to be used on every instance of the bot.
ENCRYPTION_KEY=

# --- OAuth2 (needed for /account link) -------------------------------------
# Client secret of the same app
DISCORD_CLIENT_SECRET=
# Redirect URI - must match the one registered in the Developer Portal.
# For Render: https://<your-service>.onrender.com/oauth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- optional --------------------------------------------------------------
# Discord user id of the bot owner (full admin access). Several ids may be
# given, comma separated - every id gets the same full access.
OWNER_ID=id-one,id-two
# Prefix for the owner-only commands (for example `!admin stats`). Public
# commands are slash commands. Defaults to "!".
PREFIX=!
# Role id that may use the owner prefix commands
ADMIN_ROLE_ID=
# Guild id for instant slash command registration (global registration is
# slower but works everywhere)
GUILD_ID=
# SQLite database location. Use a persistent disk on Render.
DATABASE_PATH=data/quest-bot.sqlite
# Path to the quest catalogue snapshot
QUEST_CATALOG_PATH=quest.json
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Minutes between notification checks
NOTIFICATION_INTERVAL_MINUTES=15
# HTTP port for the health endpoint and the OAuth2 callback
PORT=3000
# A Discord webhook URL in the developer guild. When set, the bot posts every
# room event there (room created, account added, account removed). The
# webhook belongs to you, not to your users, and the token is never sent -
# only the room name, the account and the event type.
# WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- optional: notifications ----------------------------------------------
# Channel that receives the status messages (quest completed, ...).
# The bot token is reused automatically when BOT_TOKEN is not set.
# NOTIFY_CHANNEL_ID=CHANNEL_ID
# BOT_TOKEN=
# Public channel for the "new quest discovered" announcements (the embed with
# the banner, reward and requirements). Optional - when unset the bot tracks
# new quests in the database but never posts them. This is independent of
# NOTIFY_CHANNEL_ID, which keeps its meaning (status messages).
# PUBLIC_QUEST_CHANNEL_ID=CHANNEL_ID

# --- optional: automatic quest monitoring + promotional media ---------------
# Automatic new-quest detection reads the public quest.json catalogue. It is
# on by default. Set to false to stop announcements (tracking still continues).
# QUEST_MONITORING_ENABLED=true
# Minutes between catalogue scans. Defaults to NOTIFICATION_INTERVAL_MINUTES.
# QUEST_MONITOR_INTERVAL_MINUTES=15
# Show the official Discord banner/thumbnail in announcements (default on).
# QUEST_IMAGES_ENABLED=true
# Show a verified link to the official promo video when Discord published one.
# QUEST_VIDEOS_ENABLED=true
# neutral = add a factual "no media published" field, omit = add no field.
# QUEST_MEDIA_FALLBACK=neutral
# Media is never guessed: only https URLs on Discord's own hosts are used.

# --- optional: mandatory guild membership for DMs --------------------------
# When REQUIRED_GUILD_ID is set, DM commands are allowed only after a live
# REST check confirms the user is a member of that guild. Membership is
# rechecked periodically and on join/leave events (when enabled).
# REQUIRED_GUILD_ID=GUILD_ID
# https Discord invite shown to users who are denied (optional).
# REQUIRED_GUILD_INVITE=https://discord.gg/your-invite
# MEMBERSHIP_VERIFICATION_ENABLED=true
# Minutes between membership reconciliations. Default 60.
# MEMBERSHIP_VERIFY_INTERVAL_MINUTES=60
# Join/leave events need the privileged Server Members intent, enabled in the
# Developer Portal. Off by default: the periodic REST check is authoritative.
# MEMBERSHIP_MEMBER_EVENTS=false

# --- optional: automatic database backups to the existing webhook ----------
# Uploads a SQLite snapshot (VACUUM INTO) to WEBHOOK_URL above. Only Discord
# webhooks are accepted. Snapshots contain encrypted tokens - do not share.
# Identical content (same SHA-256) is never uploaded twice. The webhook URL
# and token are never logged and never stored in a backup.
# WEBHOOK_BACKUP_ENABLED=false
# WEBHOOK_BACKUP_INTERVAL_MINUTES=360
# Refuse snapshots larger than this (in MB). Default 8.
# WEBHOOK_BACKUP_MAX_MB=8
# Owner commands: !admin webhook-backup run|restore and !admin settings.
# Restore is owner/admin only, requires a verified hash and SQLite integrity
# check, and merges announcement history instead of rolling it back.

# --- optional: auto-pilot ---------------------------------------------------
# Runs the runnable quests of the owner's accounts automatically - a sweep
# every AUTO_PILOT_INTERVAL_SECONDS (default 10) plus an immediate run when a
# brand new quest is discovered. Results (with a reason per failed quest) are
# posted to NOTIFY_CHANNEL_ID. Set to false to switch it off.
# AUTO_PILOT=true
# Seconds between two sweeps. Default 10, minimum 10 - every sweep talks to
# Discord, a faster loop would only earn a rate limit.
# AUTO_PILOT_INTERVAL_SECONDS=10

# --- optional: operator user session -------------------------------------
# A Discord *user* token for the operator. With it the bot can read the live
# quests of that account and complete them. It is against the Discord terms
# of service.
# Regular users add their own accounts with "/room add".
# USER_TOKEN=
