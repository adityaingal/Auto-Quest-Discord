# Discord *user* token (F12 -> Network -> users/@me -> authorization header).
# A bot token will NOT work: quests are a user-account feature.
TOKEN=

# Optional: several accounts in one variable (comma/space/semicolon separated).
# Ignored when accounts.json exists.
# TOKENS=TOKEN_1,TOKEN_2,TOKEN_3

# Optional: path to the account list file (default: accounts.json).
# ACCOUNTS_FILE=accounts.json

# Optional: captcha service used to auto-claim rewards (Discord requires an
# hCaptcha for POST /quests/{id}/claim-reward). Leave empty to claim manually
# in the Discord client.
# CAPTCHA_SERVICE=2captcha
# CAPTCHA_API_KEY=

# Optional: a Discord bot that posts status messages into a channel.
# The bot never touches the quests - it only reports what happened.
# BOT_TOKEN=YOUR_BOT_TOKEN
# NOTIFY_CHANNEL_ID=CHANNEL_ID

# Optional: turn the bot into a control panel. When set, the bot listens for
# commands (!status, !quests, !run, !stop) in that channel.
# BOT_COMMAND_CHANNEL_ID=CHANNEL_ID
# BOT_ADMIN_USER_IDS=YOUR_USER_ID,OTHER_USER_ID
# BOT_PREFIX=!

# Optional: minutes between quest runs. 0 = run once and exit.
# LOOP_MINUTES=0

# Optional: seconds between account connections (Discord limits identify rate).
# ACCOUNT_STAGGER_SECONDS=8

# Optional: force plain log output (auto-detected when there is no TTY).
# PLAIN_OUTPUT=0
